{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Replay",
  "version": "0.6.6",
  "identifier": "com.local.radioreplay.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radio Replay",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "capabilities": ["main-window", "mini-player"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'none'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Your local music collection, on your frequency.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "../assets/icons/radio.ico",
      "../assets/icons/radio.png"
    ]
  }
}
