{
  "name": "radio-replay",
  "version": "0.5.0",
  "description": "A local GTA-inspired radio player",
  "author": "Skylark",
  "license": "MIT",
  "desktopName": "com.local.radioreplay.desktop",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/duration-cache.cjs && node --check src/metadata-service.cjs && node --check src/metadata-worker.cjs && node --check src/renderer/app.js",
    "test:cache": "node --test tests/duration-cache.cjs",
    "test:metadata": "electron tests/metadata-electron.cjs",
    "smoke": "electron tests/smoke-electron.cjs",
    "icons": "electron scripts/build-icons.cjs",
    "package:win": "electron-builder --win portable --x64",
    "package:linux": "electron-builder --linux AppImage --x64",
    "package:mac:x64": "electron-builder --mac zip --x64",
    "package:mac:arm64": "electron-builder --mac zip --arm64",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "com.local.radioreplay",
    "productName": "Radio Replay",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/audio/static.mp3",
        "to": "assets/audio/static.mp3"
      },
      {
        "from": "assets/icons/radio.png",
        "to": "assets/icons/radio.png"
      },
      {
        "from": "assets/icons/tray-mask.png",
        "to": "assets/icons/tray-mask.png"
      }
    ],
    "win": {
      "icon": "assets/icons/radio.ico",
      "artifactName": "Radio-Replay-${version}-Windows-${arch}.${ext}",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icons/radio.svg",
      "category": "AudioVideo",
      "artifactName": "Radio-Replay-${version}-Linux-${arch}.${ext}",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "assets/icons/radio.svg",
      "category": "public.app-category.music",
      "artifactName": "Radio-Replay-${version}-macOS-${arch}.${ext}",
      "target": [
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  },
  "dependencies": {
    "music-metadata": "^12.3.2"
  }
}
