{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Replay Preview",
  "version": "0.1.0",
  "identifier": "com.local.radioreplay.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Radio Replay", "width": 1200, "height": 800, "minWidth": 760, "minHeight": 560 }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icons/radio.ico", "../../assets/icons/radio.png"]
  }
}
