{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Replay Preview",
  "version": "0.3.2",
  "identifier": "com.local.radioreplay.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radio Replay",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Your local music collection, on your frequency.",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": ["../../assets/icons/radio.ico", "../../assets/icons/radio.png"]
  }
}
