{
  "name": "radio-replay-rust",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "desktop": "tauri dev",
    "package": "tauri build",
    "test:core": "cargo test -p radio-replay-core",
    "test:playback": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
